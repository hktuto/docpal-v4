graph TB
    %% Main System Container
    subgraph DocpalDocumentSystem["Docpal Document System"]
        %% Global Document Pool Section
        subgraph GlobalPool["Global Document Pool"]
            CabinetSettings["Folder Cabinet Settings"]
            StructuredFolders["Structured Folders"]
            SharedDocs["Shared Documents"]
            
            CabinetSettings --> StructuredFolders
            StructuredFolders --> SharedDocs
        end

        %% Personal Workspace Section
        subgraph PersonalWorkspace["Personal Workspace"]
            MyDocs["My Documents"]
            Drafts["Drafts"]
            Favorites["Favorites"]
        end

        %% Connection between Global and Personal
        GlobalPool --> PersonalWorkspace
    end

    %% Styling
    classDef globalPool fill:#d5e8d4,stroke:#82b366
    classDef personalWorkspace fill:#ffe6cc,stroke:#d79b00
    classDef component fill:#fff2cc,stroke:#d6b656

    class GlobalPool globalPool
    class PersonalWorkspace personalWorkspace
    class CabinetSettings,StructuredFolders,SharedDocs,MyDocs,Drafts,Favorites component 
