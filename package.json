{
  "name": "docpal-app",
  "private": true,
  "version": "4.0.0",
  "workspaces": [
    "libraries/*",
    "packages/*",
    "apps/*",
    "pages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm -F client dev",
    "build": "nuxt build",
    "test": "vitest --ui",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:production": "vitest",
    "testw": "vitest run --workspace",
    "test:reports": "pnpm -r --stream --if-present --no-bail test:report"
  },
  "dependencies": {
    "@vueuse/core": "^11.3.0",
    "cross-env": "^7.0.3",
    "element-plus": "2.9.6",
    "keycloak-js": "^26.2.0",
    "nuxt": "3.17.7",
    "nuxt-auth-utils": "^0.3.9",
    "vue": "3.5.6",
    "vue-inline-svg": "^3.1.4",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@nuxt/test-utils": "3.18.0",
    "@vue/test-utils": "^2.4.6",
    "@vitest/ui": "3.1.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.4",
    "happy-dom": "^17.4.7",
    "playwright-core": "^1.50.1",
    "prettier": "3.5.3",
    "sass": "^1.85.0",
    "vitest": "3.1.4"
  },
  "packageManager": "pnpm@8.14.3+sha1.872b21adeaae4e71acd5c551ba848d927d6aa446"
}
