FROM electronuserland/builder:22-wine AS base

# 更新并安装必要工具
RUN apt-get update && \
    apt-get install -y \
        ca-certificates \
        curl \
        bash \          
        git \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 全局安装 pnpm
RUN npm install -g pnpm

# 设置默认 shell 为 bash
SHELL ["/bin/bash", "-c"]

# 可选：验证 bash 安装
RUN which bash || echo "bash not found!"
