                "labelTooltip": null,
                "onCreated": "",
                "onMounted": "this.globalOptionData.fileList = []\nthis.globalOptionData.folderList = []\n$api.get('/docpal/types/active', {}).then(res => {\n  res = res.data.data\n conso  res.forEach((item) => {\n    const _item = {\n       value: item.name,\n      label: item.name ? $t(item.name) : \n    }\n    if(item.isFolder) {\n      this.globalOptionData.folderList.push(_item)\n    } else {\n      this.globalOptionData.fileList.push(_item)\n    }\n  })\n  this.loadOptions(this.globalOptionData.folderList)\n}).catch(err => {\n  console.log(\"error\", err)\n})",
                "onRemoteQuery": "",
                "onChange": "const metadataRef = this.getWidgetRef('metadata')\nif(value) {\n  $api.get(`/docpalType/settings/name/${value}`).then(res => {\n     res = res.data.data\n     console.log(res)\n     if(!res) return\n  if(!res.metadata){metadataRef.loadOptions([]) return}  const reponse =  res.metadata.reduce((prev,item) => {\n      prev.push({\n        ...item,\n        value: item.metadata,\n        label: item.metadata\n      })\n      return prev\n    }, [])\n     console.log(reponse)\n    metadataRef.loadOptions(reponse)\n    const vform = this.getFormRef()\n    vform.$emit('emit', 'docTypeChange', {\n      value,\n      metaList: reponse\n    })\n  }).catch(err => {\n  })\n} else {\n  metadataRef.loadOptions([])\n}\n\n\n",
                "onFocus": "",
                "onBlur": "",
                "onValidate": ""
              },
