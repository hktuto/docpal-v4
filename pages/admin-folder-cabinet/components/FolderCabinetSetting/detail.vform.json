                "onMounted": "const _this = this\nconst needUserList = [\n  'notificationReminder.tos',\n  'emailReminder.tos',\n  'emailReminder.ccs',\n  'emailReport.tos',\n  'emailReport.ccs'\n]\n$api.post('/nuxeo/identity/users', {}).then(res => {\n  res = res.data.data\n  const result = []\n  res.forEach(item => {\n    if(item.username || item.userId && item.email) {\n      result.push({\n        label: `${item.userId || item.username}<${item.email}>`,\n        value: item.userId || item.username\n      })\n    }\n  })\n  result.sort((a, b) => a.label.localeCompare(b.label))\n  result.unshift({\n     value: 'createBy',\n     label: $t('role.creator')\n  })\n  needUserList.forEach(key => {\n    const keyRef = _this.getWidgetRef(key)\n    if(!!keyRef) keyRef.loadOptions(result)\n  })\n}).catch(err => {\n})",
