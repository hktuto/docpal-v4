        "onCreated": "const _this = this\nasync function getOptions() {\n  const options = await $api.get('/docpal/master/tables').then(res => res.data.data)\n  return options.map((item) => ({\n    label: item.name,\n    id: item.id,\n    value: item.name\n  }))\n}\nasync function init() {\n  const options = await getOptions()\n  _this.loadOptions(options)\n}\ninit()",
        "onMounted": "",
        "onRemoteQuery": "",
        "onChange": "// /api/docpal/master/tables/{id}\n// relationField\n// displayField\n// sean需求2024/3/14 16:30 ：取消ignoreList,displayField取消filter\nconst _this = this\nconst ignoreList = ['created_date', 'created_by','modified_date', 'modified_by']\nasync function getOptions() {\n  try {\n    const optionItems = _this.getOptionItems()\n    const optionItem = optionItems.find(item => item.value === value)\n    const options = await $api.get(`/docpal/master/tables/${optionItem.id}`).then(res => res.data.data.fields)\n    return options.reduce((prev, item) => {\n      if(\n          item.dataType !== 'Relation' ||\n          item.columnName === 'id') {\n        const _item = {\n          label: item.columnName,\n          value: item.columnName,\n          unique: item.unique\n        }\n        prev.push(_item)\n      }\n      return prev\n    }, [])\n  }\n  catch {\n    return []\n  }\n}\nasync function init() {\n  const options = await getOptions()\n  try{\n    const relationFieldRef = _this.getWidgetRef('relationField')\n    const displayFieldRef = _this.getWidgetRef('displayField')\n    relationFieldRef.loadOptions(options.filter(item => item.unique || item.label === 'id'))\n    displayFieldRef.loadOptions(options)\n  }\n  catch{}\n}\ninit()",
