        "onMounted": "const _this = this\ngetData()\n\nasync function getData() {\n  const userData = await $api.post('/nuxeo/identity/users', {}).then(res => res.data.data)\n  const _userData = userData.reduce((prev,item) => {\n    if(item.userId) prev.push({\n      value: item.userId,\n      label: item.username\n    })\n    return prev\n  }, [])\n  \n  const groupData = await $api.post('/nuxeo/identity/groups', {}).then(res => res.data.data)\n  const _groupData = groupData.reduce((prev,item) => {\n    if(item.id) prev.push({\n      value: item.id,\n      label: item.name\n    })\n    return prev\n  }, [])\n  \n  _this.loadOptions([\n    { label: $t('user_groups'), options: _groupData },  \n    { label: $t('user_users'), options: _userData }  \n  ])\n}",
