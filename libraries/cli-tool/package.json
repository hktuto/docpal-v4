{
  "name": "cli",
  "version": "1.0.0",
  "description": "CLI tool for generating new packages and pages in DocPal monorepo",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "docpal": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
