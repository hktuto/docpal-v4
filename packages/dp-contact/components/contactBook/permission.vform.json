  "formConfig": {
    "modelName": "formData",
    "refName": "vForm",
    "rulesName": "rules",
    "labelWidth": 80,
    "labelPosition": "top",
    "size": "",
    "labelAlign": "label-left-align",
    "cssCode": ".divider-mb-5 {\n  margin-bottom: 5px;\n  min-height: unset!important;\n}",
    "customClass": [],
    "functions": "",
    "layoutType": "PC",
    "jsonVersion": 3,
    "isCreateDynamicCode": true,
    "onFormCreated": "",
    "onFormMounted": "const list = ['read', 'create', 'delete', 'edit', 'manage']\nconst _this = this\nasync function getOptions() {\n  const options = [\n        { value: 'user_roles', label: $i18n.t('user_role'), options: await roleListFilter() },\n        { value: 'user_users', label: $i18n.t('user_users'), options: await userListFilter() },\n        { value: 'user_groups', label: $i18n.t('user_groups'), options: await groupListFilter() },\n  ]\n  list.forEach(key => {\n    try {\n      const widgetRef = _this.getWidgetRef(key)\n      widgetRef.loadOptions(options)\n    } catch (e) {}\n  })\n  const widgetRef = _this.getWidgetRef('permissions')\n  widgetRef.loadOptions(options)\n}\nasync function userListFilter () {\n  const data = await $api.post('/nuxeo/identity/users', {}).then(res => res.data.data)\n  return data.reduce((prev,item) => {\n    if (item.userId) prev.push({\n      label: item.username,\n      value:  item.userId\n    })\n    return prev\n  }, [])\n}\nasync function groupListFilter () {\n  const data = await $api.post('/nuxeo/identity/groups', {}).then(res => res.data.data)\n  return data.reduce((prev,item) => {\n    if (item.id) prev.push({\n      label: item.name,\n      value:  item.id\n    })\n    return prev\n  }, [])\n}\nasync function roleListFilter () {\n  try {\n    const data = await $api.get('/docpal/acl/role/root').then((res) => res.data.data)\n    const roleList = data ? makeFlapRoleList([data]) : []\n    return roleList.map((item) => ({\n      label: item.name,\n      value:  item.id\n    }))\n  } catch (error) {\n    console.error(error)\n    return []\n  }\n}\nfunction makeFlapRoleList(data, roleList = []) {\n  data.forEach((node) => {\n    const _node = { ...node }\n    delete _node.children\n    roleList.push(_node)\n    if (node.children) {\n      makeFlapRoleList(node.children, roleList)\n    }\n  })\n  return roleList\n}\ngetOptions()",
