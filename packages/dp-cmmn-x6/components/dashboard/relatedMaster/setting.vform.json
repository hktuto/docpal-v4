        "onCreatedSetting": "async-select",
        "onChangeSetting": true,
        "onCreated": "const _this = this\nasync function getList() {\n  const data = await $api.get('/docpal/master/tables?type=all').then(res => res.data.data)\n  return data.reduce((prev, item) => {\n    if(!item.id || !item.name) return prev \n    const resultItem = {\n      value: item.id,\n      label: item.name || '' \n    }\n    prev.push(resultItem) \n    return prev\n  }, []).sort((a,b)=> (a.label.localeCompare(b.label) ))\n\n}\nasync function init() {\n  const options = await getList()\n  console.log(options)\n  _this.loadOptions(options)\n}\ninit()",
        "onCreatedPlus": "",
        "onMounted": "",
        "onRemoteQuery": "",
        "onChange": "const _this = this\nloadColumn()\ninitLabel()\nfunction initLabel () {\n  try {\n    const optionsItems = _this.getOptionItems()\n    const curItem = optionsItems.find(item => item.value === value)\n    const labelRef =  _this.getWidgetRef('label')\n    const nameRef = _this.getWidgetRef('name')\n    labelRef.setValue(curItem.label)\n    nameRef.setValue(curItem.label)\n  } catch(error) {\n    console.error(error)\n  }\n}\n\nasync function loadColumn() {\n  const displayColumnsRef = _this.getWidgetRef('displayColumns')\n  if(!!oldValue) {\n    displayColumnsRef.setValue([])\n    displayColumnsRef.loadOptions([]) \n  }\n  if(!value) {\n    return\n  }\n  const options = await getOptions(value)\n  displayColumnsRef.loadOptions(options) \n  \n  const relatedFieldRef =  _this.getWidgetRef('relatedField')\n  const clickActionIdRef = _this.getWidgetRef('clickActionId')\n  relatedFieldRef.loadOptions(options) \n  clickActionIdRef.loadOptions(options) \n} \n\nasync function getOptions(id) {\n try {\n    const data = await $api.get(`/docpal/master/tables/${id}`).then(res => res.data.data)\n    return data.fields.reduce((prev, item) => {\n      const resultItem = {\n        value: item.columnName,\n        label: item.columnName || '' ,\n      }\n      prev.push(resultItem) \n      return prev\n    }, []).sort((a,b)=> (a.label.localeCompare(b.label) ))\n  } catch (e) { return [] }\n}",
