                "onChange": "const _this = this\nif(!value) return\nasync function getList() {\n  try {\n    const data = await $api.get(`/docpal/case/types/${value}/caseInfo`).then(res => res.data.data)\n    return data.reduce((prev, item) => {\n      if(!item.id || !item.name) return prev \n      const resultItem = {\n        value: item.id,\n        label: item.name || '' ,\n        type: item.type\n      }\n      prev.push(resultItem) \n      return prev\n    }, []).sort((a,b)=> (a.label.localeCompare(b.label) ))\n  } catch (e) { return [] }\n}\nasync function init() {\n  const options = await getList()\n  const relatedFieldRef = _this.getWidgetRef('relatedField')\n  relatedFieldRef.loadOptions(options)\n  const groupFieldRef = _this.getWidgetRef('groupField')\n  groupFieldRef.loadOptions(options)\n  const orderFieldRef = _this.getWidgetRef('orderField')\n  orderFieldRef.loadOptions(options)\n  const filterKeyRef = _this.getWidgetRef('filterKey')\n  filterKeyRef.loadOptions(options)\n  const displayColumnsRef = _this.getWidgetRef('displayColumns')\n  displayColumnsRef.loadOptions(options)\n  const displayColumnsValue = displayColumnsRef.getValue()\n  if(!displayColumnsValue || displayColumnsValue.length === 0) displayColumnsRef.setValue(['case_id'])\n  const fields = _this.getWidgetRef('fields')\n  fields.setValue(JSON.stringify(options))\n}\n\nfunction initDialogTitle() {\n  const optionItems = _this.getOptionItems()\n  const dialogSettingTitleRef = _this.getWidgetRef('dialogSettingTitle')\n  const title = dialogSettingTitleRef.getValue()\n  const cur = optionItems.find(i => i.value === value)\n  const isTitle = !title || optionItems.find(i => i.label === title)\n  if(cur && isTitle) dialogSettingTitleRef.setValue(cur.label)\n}\nfunction initTableName() {\n  const optionItems = _this.getOptionItems()\n  const cur = optionItems.find(i => i.value === value)\n  const tableNameRef = _this.getWidgetRef('tableName')\n  const name = cur.tableName ? cur.tableName : 'ct_' + cur.uniqueName\n  tableNameRef.setValue(name)\n}\ninitTableName()\ninitDialogTitle()\ninit()\n\n",
