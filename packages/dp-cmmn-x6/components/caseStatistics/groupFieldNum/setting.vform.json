                "onCreated": "const _this = this\nasync function getList() {\n  try {\n    const data = await $api.get('/docpal/case/types?deployed=true').then(res => res.data.data)\n    return data.reduce((prev, item) => {\n      if(!item.id ) return prev \n      const resultItem = {\n        value: item.id,\n        label: item.name,\n        tableName: item.tableName,\n        uniqueName: item.uniqueName\n      }\n      prev.push(resultItem) \n      return prev\n    }, []).sort((a,b)=> (a.label.localeCompare(b.label) ))\n  } catch (e) { return [] }\n}\nasync function init() {\n  const options = await getList()\n  _this.loadOptions(options)\n}\ninit()",
